<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>InputBridge</AssemblyName>
    <RootNamespace>InputBridge.Windows</RootNamespace>
    <!-- Release builds pass -p:Version=x.y.z; 0.0.0 marks a local development build (no automatic update checks). -->
    <Version>0.0.0</Version>
    <ApplicationIcon>Assets\InputBridge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\InputBridge.ico" />
    <Resource Include="Assets\InputBridge.png" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
